{
  "name": "@suiji-ai/dsh-agentic-word-book",
  "version": "1.2.0",
  "type": "module",
  "description": "随记单词本：DSH 本地单词本插件，一个词一页，插图、发音、词组、例句，带拼写练习和单词辨析。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "assets",
    "scripts/*",
    "icon.svg",
    "skill-template.js",
    "screenshots.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shallinta/dsh-agentic-word-book.git"
  },
  "license": "MIT",
  "author": "shallinta",
  "homepage": "https://github.com/shallinta/dsh-agentic-word-book#readme",
  "bugs": {
    "url": "https://github.com/shallinta/dsh-agentic-word-book/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "word-book",
    "vocabulary",
    "flashcards",
    "english-learning",
    "spelling",
    "local-first"
  ]
}
